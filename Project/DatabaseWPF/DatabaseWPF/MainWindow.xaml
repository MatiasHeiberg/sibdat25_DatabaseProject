<Window x:Class="DatabaseWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employees CRUD" Height="450" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="EmployeesGrid"
                  Grid.Row="0"
                  AutoGenerateColumns="True"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="Reload" Width="90" Margin="0,0,10,0" Click="Reload_Click"/>
            <Button Content="Add" Width="90" Margin="0,0,10,0" Click="Add_Click"/>
            <Button Content="Save" Width="90" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="Delete" Width="90" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>